# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=debitmanager
DB_PASSWORD=your_password
DB_DATABASE=debitmanager
DB_SYNCHRONIZE=false
DB_LOGGING=true

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=your_refresh_secret_key
JWT_REFRESH_EXPIRES_IN=7d

# App
PORT=3000
NODE_ENV=development
API_PREFIX=api/v1

# File Storage
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=

# Payment Gateways
KKIAPAY_API_KEY=
KKIAPAY_SECRET_KEY=
KKIAPAY_PUBLIC_KEY=

MONEROO_API_KEY=
MONEROO_SECRET_KEY=

CINETPAY_API_KEY=
CINETPAY_SECRET_KEY=
CINETPAY_SITE_ID=

# SMS Gateway
SMS_GATEWAY_API_KEY=
SMS_GATEWAY_SENDER_ID=

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Push Notifications
FCM_PROJECT_ID=
FCM_PRIVATE_KEY=
FCM_CLIENT_EMAIL=

# Geolocation
GEOLOCATION_RADIUS_METERS=100
GEOLOCATION_CHECK_INTERVAL_MINUTES=30

# Affiliate Program
AFFILIATE_COMMISSION_RATE=10
AFFILIATE_COMMISSION_MODE=FIRST_PAYMENT
AFFILIATE_TRACKING_LIFETIME_DAYS=30
AFFILIATE_MIN_PAYOUT_AMOUNT=50000
AFFILIATE_VALIDATION_MODE=MANUAL

# Subscription
TRIAL_PERIOD_DAYS=14
GRACE_PERIOD_DAYS=3
PLATFORM_COMMISSION_RATE=1
