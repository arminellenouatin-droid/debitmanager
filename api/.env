# ============================================
# CONFIGURATION SUPABASE (Base de données)
# ============================================
# Trouvez ces informations dans: Supabase Dashboard > Settings > Database > Connection string
# Format de la connection string: postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

DB_HOST=db.lfkydptmykpgmazuxtht.supabase.co
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=3r+j9XtJuSRxUbh
DB_DATABASE=postgres
DB_SYNCHRONIZE=false
DB_LOGGING=false

# ============================================
# CONFIGURATION JWT (Authentification)
# ============================================
# Générez une clé secrète JWT sécurisée (utilisez: openssl rand -base64 32)
JWT_SECRET=ePJRfcjTqih1HClNURdJ6Qxi8PIITGIqaQlCJ47HHow=
JWT_EXPIRATION=7d

# ============================================
# CONFIGURATION REDIS (Cache - optionnel)
# ============================================
# Si vous n'utilisez pas Redis, laissez vide ou utilisez un service comme Upstash
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================
# CONFIGURATION PAYMENT GATEWAYS
# ============================================
# Pour les paiements (Stripe, PayPal, etc.)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# ============================================
# CONFIGURATION ENVIRONNEMENT
# ============================================
NODE_ENV=production
PORT=3000

# ============================================
# COMMISSION PLATEFORME
# ============================================
PLATFORM_COMMISSION_RATE=1